{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["cards"],
  "properties": {
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceKey", "sourceIndex", "word", "ipa", "partOfSpeech", "cefr", "viMeaning", "enDefinition", "exampleMeaning", "exampleUsage", "acceptedAnswers", "extras"],
        "properties": {
          "sourceKey": {"type": "string"},
          "sourceIndex": {"type": "integer", "minimum": 1},
          "word": {"type": "string"},
          "ipa": {"type": "string"},
          "partOfSpeech": {"type": "string"},
          "cefr": {"type": "string", "enum": ["A1", "A2", "B1", "B2", "C1"]},
          "viMeaning": {"type": "string"},
          "enDefinition": {"type": "string"},
          "exampleMeaning": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "vi"],
            "properties": {"en": {"type": "string"}, "vi": {"type": "string"}}
          },
          "exampleUsage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "vi", "note"],
            "properties": {"en": {"type": "string"}, "vi": {"type": "string"}, "note": {"type": "string"}}
          },
          "acceptedAnswers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "extras": {
            "type": "object",
            "additionalProperties": false,
            "required": ["collocations", "usage_note", "register", "word_family", "synonyms", "antonyms"],
            "properties": {
              "collocations": {"type": "array", "items": {"type": "string"}},
              "usage_note": {"type": "string"},
              "register": {"type": "string"},
              "word_family": {"type": "array", "items": {"type": "string"}},
              "synonyms": {"type": "array", "items": {"type": "string"}},
              "antonyms": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
